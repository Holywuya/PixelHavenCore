# ========================================
#  食物腐蚀系统 - food-corrosion
# ========================================
#  食物在背包中会随时间逐渐腐蚀，到期后自动变为腐肉。
#  Lore 以"过期时间: Xd"形式显示，每天刷新一次，避免频繁更新。
#  腐蚀速率由每物品独立配置，不同食物保质期不同。

# 配置版本号（用于未来迁移）
version: 1

# ----------------------------------------
#  总开关
# ----------------------------------------
#  设为 false 可完全关闭食物腐蚀功能，
#  同时禁用 Packet 监听器（零性能开销）。
enabled: true

# ----------------------------------------
#  腐蚀上限
# ----------------------------------------
#  每件食物的最大腐蚀值（内部计数器上限）。
#  腐蚀值从 0 递增到此阈值后，食物变为腐肉。
#  不建议修改，除非你需要更细粒度的速率控制。
#  范围: 1 ~ 10000
max-corrosion: 100

# ----------------------------------------
#  默认腐蚀速率
# ----------------------------------------
#  每次 tick（由 realworld.yml 的 tick-interval-seconds 控制间隔）
#  食物腐蚀值增加的点数。同时也是 item-rates 中未列出物品的默认值。
#  例: tick-interval=2, default-rate=1 → 每 2 秒 +1 腐蚀 → 200 秒 (3.3 分钟) 腐蚀满。
#  范围: 1 ~ 100
default-rate: 1

# ----------------------------------------
#  保质期（天）

# ----------------------------------------
#  食物从满状态到完全腐烂的总天数。
#  Lore 中的"过期时间"按此值线性换算:
#    显示天数 = (max-corrosion - 当前腐蚀) / max-corrosion * total-days
#  例: total-days=14, 当前腐蚀=0 → 显示 "14d"
#      当前腐蚀=50 → 显示 "7d"
#      当前腐蚀=100 → 显示 "0d"（已腐烂）
#  范围: 1 ~ 365
total-days: 14

# ----------------------------------------
#  Lore 显示格式
# ----------------------------------------
#  可用占位符:
#    {days}  — 剩余天数（整数）
#    {color} — 根据剩余比例自动变色的颜色代码
#               >50% 绿色 &a / >25% 黄色 &e / >10% 红色 &c / <=10% 深红 &4
#
#  Lore 仅在剩余天数发生变化时刷新，不会每个包都更新。
lore-format: "&7过期时间: {color}{days}d"

# ----------------------------------------
#  腐烂提示消息
# ----------------------------------------
#  食物完全腐蚀变为腐肉时发送给玩家的消息。
#  设为空字符串 "" 可关闭提示。
conversion-message: "&e你的食物已经完全腐烂了！"

# ----------------------------------------
#  豁免物品列表
# ----------------------------------------
#  以下 Material 名称的食物不会参与腐蚀计算。
#  已默认排除腐肉、金苹果、附魔金苹果、药水、迷之炖菜。
excluded-items:
  - ROTTEN_FLESH
  - GOLDEN_APPLE
  - ENCHANTED_GOLDEN_APPLE
  - POTION
  - SUSPICIOUS_STEW

# ----------------------------------------
#  物品专属腐蚀速率
# ----------------------------------------
#  为特定食物 Material 设置独立腐蚀速率。
#  未列出的食物使用上面的 default-rate。
#  数值越大 → 腐蚀越快 → 保质期越短。
#
#  示例计算（tick-interval=2 秒）:
#    BREAD: 2   → 每 2 秒 +2 → 100/2=50 tick → 100 秒 ≈ 1.7 分钟
#    MELON: 3   → 每 2 秒 +3 → 100/3≈33 tick → 66 秒 ≈ 1.1 分钟
item-rates:
  BREAD: 2
  MELON_SLICE: 3
